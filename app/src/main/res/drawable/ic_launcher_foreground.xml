    <path
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M37,54 L46,47 L53,40 L65,28">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="37"
                android:startY="54"
                android:endX="65"
                android:endY="28"
                android:type="linear">
                <item android:color="#F59E0B" android:offset="0.0" />
                <item android:color="#FBBF24" android:offset="0.5" />
                <item android:color="#FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Arrow Head pointing Upward-Right -->
    <path
        android:pathData="M58,26 L69,25 L68,36 L64,32 L60,32 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="58"
                android:startY="25"
                android:endX="69"
                android:endY="36"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#FDE047" android:offset="0.5" />
                <item android:color="#F59E0B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Shimmer Sparkles / Achievement Starlet -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M71,22 L72.2,25.2 L75.4,26.4 L72.2,27.6 L71,30.8 L69.8,27.6 L66.6,26.4 L69.8,25.2 Z" />
    <path
