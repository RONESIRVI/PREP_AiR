    <path
        android:strokeWidth="3.8"
        android:strokeLineCap="round"
        android:pathData="M54,26 A28,28 0 1 1 32,37">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="26"
                android:startY="26"
                android:endX="82"
                android:endY="82"
                android:type="linear">
                <item android:color="#4CEF8D" android:offset="0.0" />
                <item android:color="#38BDF8" android:offset="0.6" />
                <item android:color="#FBBF24" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ring Accent Orbital Nodes -->
    <path
        android:fillColor="#4CEF8D"
        android:pathData="M54,23 a3,3 0 1 0 0.01,0 Z" />
    <path
        android:fillColor="#38BDF8"
        android:pathData="M82,54 a2.2,2.2 0 1 0 0.01,0 Z" />
    <path
        android:fillColor="#FBBF24"
        android:pathData="M54,82 a2.5,2.5 0 1 0 0.01,0 Z" />

    <!-- Sleek Geometric Focus Shield / Hourglass Body -->
    <path
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M37,34 L71,34 L62,51 L71,68 L37,68 L46,51 Z">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="37"
                android:startY="34"
                android:endX="71"
                android:endY="68"
                android:type="linear">
                <item android:color="#504CEF8D" android:offset="0.0" />
                <item android:color="#3038BDF8" android:offset="0.5" />
                <item android:color="#504CEF8D" android:offset="1.0" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="37"
                android:startY="34"
                android:endX="71"
                android:endY="68"
                android:type="linear">
                <item android:color="#25123020" android:offset="0.0" />
                <item android:color="#350A1A12" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Central Dynamic Lightning Bolt Symbol of Peak Focus & Discipline -->
    <path
        android:pathData="M56,33 L45,51 L53,51 L48,69 L63,48 L55,48 Z">
        <aapt:attr name="android:fillColor">
