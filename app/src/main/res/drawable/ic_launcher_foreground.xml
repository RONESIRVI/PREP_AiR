        </aapt:attr>
    </path>

    <!-- Bar 3 (Mid-Right - High Accuracy) -->
    <path
        android:pathData="M51,61 L55,61 L55,37 L51,37 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="51"
                android:startY="61"
                android:endX="55"
                android:endY="37"
                android:type="linear">
                <item android:color="#FBBF24" android:offset="0.0" />
                <item android:color="#34D399" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bar 4 (Right - Peak Performance) -->
    <path
        android:pathData="M58,62 L62,62 L62,31 L58,31 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="58"
                android:startY="62"
                android:endX="62"
                android:endY="31"
                android:type="linear">
                <item android:color="#34D399" android:offset="0.0" />
                <item android:color="#10B981" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bar Highlight Caps (3D effect) -->
    <path
        android:fillColor="#FEF3C7"
        android:pathData="M37,52 L41,52 L41,53.5 L37,53.5 Z M44,44 L48,44 L48,45.5 L44,45.5 Z M51,37 L55,37 L55,38.5 L51,38.5 Z M58,31 L62,31 L62,32.5 L58,32.5 Z" />

