                android:endY="69"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#4CEF8D" android:offset="0.35" />
                <item android:color="#22C55E" android:offset="0.75" />
                <item android:color="#FBBF24" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Core Lightning Specular Flare -->
    <path
        android:fillColor="#80FFFFFF"
        android:pathData="M55,36 L47,50 L52,50 L49,60 L57,49 L54,49 Z" />

    <!-- Lateral Focus Turbine Wings -->
    <path
        android:strokeColor="#604CEF8D"
