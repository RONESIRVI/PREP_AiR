    <!-- Bar 1 (Left - Initial Stage) -->
    <path
        android:pathData="M37,63 L41,63 L41,52 L37,52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="37"
                android:startY="63"
                android:endX="41"
                android:endY="52"
                android:type="linear">
                <item android:color="#D97706" android:offset="0.0" />
                <item android:color="#F59E0B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

