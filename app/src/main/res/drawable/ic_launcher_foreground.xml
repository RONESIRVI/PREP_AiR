    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 
      Core symbol strictly centered within safe area (center: 54, 54):
      1. Open Book (Learning / Test knowledge)
      2. Rising Performance Bars (Test performance)
      3. Upward Arrow (Progress / improvement)
      Colors: Gold & Amber (#F59E0B, #FBBF24, #D97706) & Deep Navy (#0B132B) & Emerald Accent (#10B981)
    -->

    <!-- 3D Rounded-Square Icon Container Shield Subtle Backing Glow -->
    <path
        android:pathData="M32,26 L76,26 A6,6 0 0 1 82,32 L82,76 A6,6 0 0 1 76,82 L32,82 A6,6 0 0 1 26,76 L26,32 A6,6 0 0 1 32,26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="26"
                android:startY="26"
                android:endX="82"
                android:endY="82"
                android:type="linear">
                <item android:color="#30F59E0B" android:offset="0.0" />
                <item android:color="#151E3A8A" android:offset="0.6" />
                <item android:color="#250F172A" android:offset="1.0" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="26"
                android:startY="26"
                android:endX="82"
                android:endY="82"
                android:type="linear">
                <item android:color="#60FBBF24" android:offset="0.0" />
                <item android:color="#20F59E0B" android:offset="0.5" />
                <item android:color="#403B82F6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

