    <path
        android:pathData="M54,73 C48,70 38,68 31,71 L31,58 C38,55 48,57 54,60 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="31"
                android:startY="58"
                android:endX="54"
                android:endY="73"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#F1F5F9" android:offset="0.6" />
                <item android:color="#CBD5E1" android:offset="1.0" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="31"
                android:startY="58"
                android:endX="54"
                android:endY="73"
                android:type="linear">
                <item android:color="#D97706" android:offset="0.0" />
                <item android:color="#F59E0B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Page -->
    <path
        android:pathData="M54,73 C60,70 70,68 77,71 L77,58 C70,55 60,57 54,60 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="58"
                android:endX="77"
                android:endY="73"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#F8FAFC" android:offset="0.5" />
                <item android:color="#E2E8F0" android:offset="1.0" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="54"
                android:startY="58"
                android:endX="77"
                android:endY="73"
                android:type="linear">
                <item android:color="#F59E0B" android:offset="0.0" />
                <item android:color="#D97706" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Book Spine & Center Binding Ribbon -->
    <path
        android:strokeColor="#B45309"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M54,60 L54,74" />
    <path
        android:fillColor="#F59E0B"
        android:pathData="M53.2,74 L54.8,74 L55.4,77 L54,76 L52.6,77 Z" />

